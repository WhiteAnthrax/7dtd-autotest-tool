# Profile: 7 Days To Die 3.0 (main line of VisitedTraderTeleport)
#
# Copy this file to config/v3.env and fill in the values for your own environment.
# config/*.env is gitignored; only *.env.example is committed.

# --- Windows build/test host (SSH, resolved via ~/.ssh/config on this machine) ---
OMEN_SSH_HOST=omen-build
OMEN_USER_ID=CHANGE_ME            # the Windows username the scheduled task runs as
OMEN_SCRATCH_DIR='C:\7dtd-autotest-scratch'
OMEN_QUEUE_DIR='D:\testpilot-queue'
OMEN_TASK_NAME=TestPilotAutotestRun

# --- Client (game) install this profile targets ---
GAME_FLAVOR=v3
CLIENT_GAME_PATH='D:\GAMES\7D2D\Custom\3.0Vanilla'
CLIENT_MODS_DIR='D:\GAMES\7D2D\Custom\3.0Vanilla\Mods'
CLIENT_EXE_NAME=7DaysToDie.exe
VTT_CLIENT_MOD_DIRNAME='Travel Between Visited Traders'   # display name of the mod folder under Mods\

# --- Dedicated server (Docker, on this machine) ---
DOCKER_COMPOSE_DIR=/zfs/GAME-SERVERS/7dtd-server
DOCKER_SERVICE_NAME=7dtdserver
DOCKER_CONTAINER_NAME=7dtdserver
SERVER_IP=192.168.123.2           # LAN IP the client connects to (not the container's public IP)
SERVER_PORT=26900
READY_TIMEOUT_SECONDS=300         # first connect downloads the world; bump for a cold cache
VTT_MOD_DISPLAY_NAME=VisitedTraderTeleport   # name that appears in "Loaded Mod: <name>" server-side
SERVER_MODS_DIR="${DOCKER_COMPOSE_DIR}/data/serverfiles/Mods"
SERVER_SAVES_DIR="${DOCKER_COMPOSE_DIR}/data/.local/share/7DaysToDie/Saves"
# Must exactly match sdtdserver.xml's <property name="GameName" .../> on this server.
# Used to find the right save's VisitedTraderTeleportData.json - see 03-deploy-mods.sh
# for why matching "newest file" instead is unsafe on a machine with multiple worlds.
GAME_SAVE_NAME=AutotestSafe

# --- Local checkouts used to build the mods ---
VTT_REPO_PATH=/home/anthrax/work/VisitedTraderTeleport   # VisitedTraderTeleport checkout (for vtttest)
VTT_BRANCH=main
TESTPILOT_REPO_PATH=/home/anthrax/work/7dtd-autotest-tool  # this repo (for SdtdTestPilot)
