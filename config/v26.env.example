# Profile: 7 Days To Die v2.6 (v26-work line of VisitedTraderTeleport)
#
# Copy this file to config/v26.env and fill in the values for your own environment.
# config/*.env is gitignored; only *.env.example is committed.

# --- Windows build/test host (SSH, resolved via ~/.ssh/config on this machine) ---
OMEN_SSH_HOST=omen-build
OMEN_USER_ID=CHANGE_ME
OMEN_SCRATCH_DIR='C:\7dtd-autotest-scratch-v26'
OMEN_QUEUE_DIR='D:\testpilot-queue-v26'
OMEN_TASK_NAME=TestPilotAutotestRunV26

# --- Client (game) install this profile targets ---
GAME_FLAVOR=v26
CLIENT_GAME_PATH='D:\GAMES\7D2D\v2\The_Wasteland\The_Wasteland'
CLIENT_MODS_DIR='D:\GAMES\7D2D\v2\The_Wasteland\The_Wasteland\Mods'
CLIENT_EXE_NAME=7DaysToDie.exe
VTT_CLIENT_MOD_DIRNAME='Travel Between Visited Traders'

# --- Dedicated server (Docker, on this machine) ---
DOCKER_COMPOSE_DIR=/zfs/GAME-SERVERS/7dtd-server-v26-wasteland
DOCKER_SERVICE_NAME=7dtdserver
DOCKER_CONTAINER_NAME=7dtdserver-v26-wasteland
SERVER_IP=192.168.123.2
SERVER_PORT=26900
READY_TIMEOUT_SECONDS=300
VTT_MOD_DISPLAY_NAME=VisitedTraderTeleport
SERVER_MODS_DIR="${DOCKER_COMPOSE_DIR}/data/serverfiles/Mods"
SERVER_SAVES_DIR="${DOCKER_COMPOSE_DIR}/data/.local/share/7DaysToDie/Saves"
# Must exactly match sdtdserver.xml's <property name="GameName" .../> on this server.
# Used to find the right save's VisitedTraderTeleportData.json - see 03-deploy-mods.sh
# for why matching "newest file" instead is unsafe on a machine with multiple worlds.
GAME_SAVE_NAME=AutotestSafe

# --- Local checkouts used to build the mods ---
VTT_REPO_PATH=/home/anthrax/work/VisitedTraderTeleport
VTT_BRANCH=v26-work
TESTPILOT_REPO_PATH=/home/anthrax/work/7dtd-autotest-tool
