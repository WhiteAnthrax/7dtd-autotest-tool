# Credentials for bin/publish-to-nexus.sh.
#
# The real file belongs OUTSIDE this repo - the script reads ~/.config/nexus-upload.env by
# default (override with NEXUS_ENV_FILE). Create it with mode 600:
#
#   install -m 600 /dev/null ~/.config/nexus-upload.env
#   $EDITOR ~/.config/nexus-upload.env
#
# Get a personal API key from https://www.nexusmods.com/users/myaccount?tab=api
# It is equivalent to write access to your mod pages - never commit it, never pass it as a
# command-line argument (it would land in shell history and in the process list).
NEXUS_API_KEY=
