# .NET build outputs (scoped to project subdirectories only - bin/ at the
# repo root holds this project's orchestration scripts, not build output)
src/*/bin/
src/*/obj/
tests/*/bin/
tests/*/obj/
*.user
*.suo

# Generated build/package outputs
mod/SdtdTestPilot/*.dll

# Local copies of 7 Days to Die assemblies/config used only for compilation
# and API inspection. Do not redistribute these game files.
refs/*
!refs/README.md

# Environment-specific profile config (real values; commit only *.env.example)
# Copies kept by hand (v3.env.bak-1006 and the like) hold the same real values.
config/*.env
config/*.env.*
!config/*.env.example

# Runtime artifacts from test runs (logs, command-queue captures, etc.)
output/
