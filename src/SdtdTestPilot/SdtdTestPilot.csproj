<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>SdtdTestPilot</AssemblyName>
    <RootNamespace>SdtdTestPilot</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!--
    This entire mod only activates in a Debug build (TESTPILOT_ENABLED). It is a test-only
    driver that auto-connects/auto-hosts and injects console commands from local files, and
    must never be shipped or run against a real/public server. See docs/HeadlessTestDriver.md.
  -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DefineConstants>$(DefineConstants);TESTPILOT_ENABLED</DefineConstants>
  </PropertyGroup>

  <!--
    GameFlavor selects which game-version-specific API shape to compile against (see
    AutoSpawnDriver.cs). Pass -p:GameFlavor=v26 when building against a 7DTD v2.6 GamePath;
    omit it (or pass v3, the default) for 7DTD 3.0.
  -->
  <PropertyGroup>
    <GameFlavor Condition="'$(GameFlavor)'==''">v3</GameFlavor>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GameFlavor)'=='v26'">
    <DefineConstants>$(DefineConstants);GAME_V26</DefineConstants>
  </PropertyGroup>

  <!--
    SdtdTestPilot.Core holds the engine-free subset of this mod's logic (option parsing, queue
    file naming, result JSON) so it can be unit-tested without the proprietary game assemblies
    below. Sources are compiled directly into this project, mirroring VisitedTraderTeleport's
    split (see src/VisitedTraderTeleport/VisitedTraderTeleport.csproj).
  -->
  <ItemGroup>
    <Compile Include="..\SdtdTestPilot.Core\*.cs">
      <Link>Core\%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\..\refs\managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>..\..\refs\managed\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\refs\managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\..\refs\managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyToModFolder" AfterTargets="Build">
    <MakeDir Directories="..\..\mod\SdtdTestPilot" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="..\..\mod\SdtdTestPilot" />
  </Target>
</Project>
